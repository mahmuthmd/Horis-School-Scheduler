<Window x:Class="DersProgramiUI.MusaitlikPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müsaitlik Ayarları" Height="480" Width="1050"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık ve Açıklama -->
            <RowDefinition Height="*"/>
            <!-- 7x10 Matris Izgarası -->
            <RowDefinition Height="Auto"/>
            <!-- Kaydet / İptal Butonları -->
        </Grid.RowDefinitions>

        <!-- BAŞLIK & AÇIKLAMA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="lblBaslik" Text="Öğretmen Müsaitlik Zamanları" FontSize="18" FontWeight="Bold" Foreground="DarkSlateGray"/>
            <TextBlock Text="💡 Öğretmenin GELEMEYECEĞİ saatleri kırmızı (❌ Engelli) yapmak için kutulara tıklayın." FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 7x10 MATRİS ALANI (C# Tarafından Dinamik Doldurulacak) -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Background="#FAFAFA">
            <UniformGrid x:Name="gridMatris" Columns="8" Rows="11"/>
        </Border>

        <!-- BUTONLAR -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnKaydet" Content="💾 Tercihleri Kaydet" Background="ForestGreen" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,10,0" Click="btnKaydet_Click"/>
            <Button x:Name="btnKapat" Content="❌ İptal" Background="IndianRed" Foreground="White" FontWeight="Bold" Padding="12,6" Click="btnKapat_Click"/>
        </StackPanel>
    </Grid>
</Window>