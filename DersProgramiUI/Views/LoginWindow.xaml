<Window x:Class="DersProgramiUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Horis - Giriş" 
        Height="520" Width="400"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Grid Margin="20">
        <!-- Modern Material Card -->
        <materialDesign:Card UniformCornerRadius="10" Padding="25" VerticalAlignment="Center">
            <StackPanel>

                <!-- Okul / Eğitim İkonu -->
                <materialDesign:PackIcon Kind="School" Width="44" Height="44" 
                                         HorizontalAlignment="Center" 
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                         Margin="0,0,0,8"/>

                <TextBlock Text="HORİS" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50"/>

                <TextBlock Text="Ders Programı Uygulaması" FontSize="16" FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50" Margin="0,2,0,0"/>

                <TextBlock Text="Sisteme erişebilmek için giriş yapın" FontSize="11" 
                           Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,18"/>

                <!-- Kullanıcı Adı (Outlined Stil) -->
                <TextBox x:Name="txtKullaniciAdi" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="E-posta veya Kullanıcı Adı"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Margin="0,0,0,12"/>

                <!-- Şifre Kutusu -->
                <PasswordBox x:Name="txtSifre" 
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             materialDesign:HintAssist.Hint="Şifre"
                             Margin="0,0,0,10"/>

                <!-- 🎯 Beni Hatırla Seçeneği -->
                <CheckBox x:Name="chkBeniHatirla" 
                          Content="Beni Hatırla (30 Gün)" 
                          IsChecked="True"
                          FontSize="12" 
                          Foreground="#2C3E50" 
                          Margin="2,0,0,16"/>

                <!-- Giriş Yap Butonu -->
                <Button x:Name="btnGiris" Content="🔒 GİRİŞ YAP" 
                        Height="44" FontSize="13" FontWeight="Bold"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Click="btnGiris_Click"/>

                <!-- İlerleme Çubuğu -->
                <ProgressBar x:Name="pnlYukleniyor" IsIndeterminate="True" 
                             Margin="0,12,0,0" Visibility="Collapsed" 
                             Style="{StaticResource MaterialDesignLinearProgressBar}"/>

                <!-- Durum / Hata Metni -->
                <TextBlock x:Name="lblDurum" Text="" Foreground="Crimson" 
                           FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>

            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>