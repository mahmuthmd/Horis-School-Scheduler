<Window x:Class="DersProgramiUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Horis - Ders Programı Hazırlama Yazılımı" Height="740" Width="1100" 
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        Loaded="Sayfa_Loaded">

    <!-- GENEL KONTROL STİLLERİ -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <TabControl x:Name="tabControlAna" SelectionChanged="tabControlAna_SelectionChanged" Background="White" BorderBrush="#E0E0E0">

            <!-- 👨‍🏫 1. SEKME: ÖĞRETMEN İŞLEMLERİ -->
            <TabItem Header="👨‍🏫 Öğretmenler" FontSize="13" FontWeight="Bold" Padding="10,5">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0" Background="#FAFAFA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="lblFormBaslik" Text="Yeni Öğretmen Ekle" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>

                                <TextBlock Text="Ad Soyad:" Margin="0,0,0,4" Foreground="#34495E" FontSize="11"/>
                                <TextBox x:Name="txtOgretmenAd" Margin="0,0,0,10"/>

                                <TextBlock Text="Branş:" Margin="0,0,0,4" Foreground="#34495E" FontSize="11"/>
                                <TextBox x:Name="txtOgretmenBrans" Margin="0,0,0,15"/>
                                <!-- ÖĞRETMEN HEDEF GÜN SAYISI -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Okula Geleceği Max Gün Sayısı:" FontWeight="Bold" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbOgretmenHedefGun" Height="30" FontSize="14" SelectedIndex="0">
                                        <ComboBoxItem Content="0 (Sınır Yok - Her gün gelebilir)" />
                                        <ComboBoxItem Content="1 Gün" />
                                        <ComboBoxItem Content="2 Gün" />
                                        <ComboBoxItem Content="3 Gün" />
                                        <ComboBoxItem Content="4 Gün" />
                                        <ComboBoxItem Content="5 Gün" />
                                        <ComboBoxItem Content="6 Gün" />
                                        <ComboBoxItem Content="7 Gün" />
                                    </ComboBox>
                                </StackPanel>

                                <Button x:Name="btnOgretmenEkle" Content="➕ Öğretmen Ekle" Background="#27AE60" Click="btnOgretmenEkle_Click"/>

                                <StackPanel x:Name="pnlOgretmenDuzenleButonlari" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Button Content="💾 Güncelle" Background="#2980B9" Margin="0,0,0,5" Click="btnOgretmenGuncelle_Click"/>
                                    <Button Content="❌ İptal" Background="#7F8C8D" Click="btnDuzenleIptal_Click"/>
                                </StackPanel>

                                <Separator Margin="0,15,0,15"/>

                                <TextBlock Text="🎯 Konfor Kurallarına Tabi Öğretmenler:" FontWeight="Bold" Foreground="#C0392B" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="💡 Buraya eklenen öğretmenler için pencere ve 1s geliş engeli katı uygulanır." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbKatiOgretmenSecim" DisplayMemberPath="Ad"/>
                                    <Button Grid.Column="1" Content="➕ Ekle" Background="#E67E22" Margin="5,0,0,0" Padding="8,4" Click="btnKatiOgretmenEkle_Click"/>
                                </Grid>

                                <ListBox x:Name="lstKatiOgretmenler" Height="90" DisplayMemberPath="Ad" Margin="0,0,0,6"/>
                                <Button Content="➖ Seçileni Kaldır" Background="#E74C3C" Padding="6,4" Click="btnKatiOgretmenSil_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="txtOgretmenAra" Margin="0,0,0,10" TextChanged="txtOgretmenAra_TextChanged" ToolTip="Öğretmen ara..."/>
                        <DataGrid Grid.Row="1" x:Name="dgOgretmenler" AutoGenerateColumns="False" IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding Ad}" Width="*"/>
                                <DataGridTextColumn Header="Branş" Binding="{Binding Brans}" Width="*"/>
                                <DataGridTextColumn Header="Toplam Saat" Binding="{Binding ToplamDersSaati}" Width="100" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="İşlemler" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0">
                                                <Button Content="📅 Müsaitlik" Background="#3498DB" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnMusaitlik_Click"/>
                                                <Button Content="✏️ Düzenle" Background="#F39C12" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnOgretmenDuzenle_Click"/>
                                                <Button Content="🗑️ Sil" Background="#E74C3C" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnOgretmenSil_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 📚 2. SEKME: DERS İŞLEMLERİ -->
            <TabItem Header="📚 Dersler" FontSize="13" FontWeight="Bold" Padding="10,5">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0" Background="#FAFAFA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="lblDersFormBaslik" Text="Yeni Ders Ekle" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>

                                <TextBlock Text="Ders Adı (Örn: Matematik):" Margin="0,0,0,4" Foreground="#34495E" FontSize="11"/>
                                <TextBox x:Name="txtDersAd" Margin="0,0,0,10"/>

                                <TextBlock Text="Kısa Ad (Örn: MAT):" Margin="0,0,0,4" Foreground="#34495E" FontSize="11"/>
                                <TextBox x:Name="txtDersKisaAd" Margin="0,0,0,10"/>

                                <TextBlock Text="Dersi Verebilecek Öğretmenler:" FontWeight="Bold" Margin="0,5,0,5" FontSize="11"/>
                                <ListBox x:Name="lstOgretmenSecim" Height="140" Margin="0,0,0,15">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Ad}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button x:Name="btnDersEkle" Content="➕ Ders Ekle" Background="#27AE60" Click="btnDersEkle_Click"/>

                                <StackPanel x:Name="pnlDersDuzenleButonlari" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Button x:Name="btnDersGuncelle" Content="💾 Güncelle" Background="#2980B9" Margin="0,0,5,0" Click="btnDersGuncelle_Click"/>
                                    <Button x:Name="btnDersDuzenleIptal" Content="❌ İptal" Background="#7F8C8D" Click="btnDersDuzenleIptal_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="txtDersAra" Margin="0,0,0,10" TextChanged="txtDersAra_TextChanged"/>
                        <DataGrid Grid.Row="1" x:Name="dgDersler" AutoGenerateColumns="False" IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ders Adı" Binding="{Binding Ad}" Width="*"/>
                                <DataGridTextColumn Header="Kısa Ad" Binding="{Binding KisaAd}" Width="100"/>
                                <DataGridTextColumn Header="Öğretmenler" Binding="{Binding VerenOgretmenlerMetni}" Width="2*"/>
                                <DataGridTemplateColumn Header="İşlemler" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0">
                                                <Button Content="✏️ Düzenle" Background="#F39C12" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnDersDuzenle_Click"/>
                                                <Button Content="🗑️ Sil" Background="#E74C3C" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnDersSil_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 🏫 3. SEKME: SINIF İŞLEMLERİ -->
            <TabItem Header="🏫 Sınıflar" FontSize="13" FontWeight="Bold" Padding="10,5">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0" Background="#FAFAFA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="lblSinifFormBaslik" Text="Yeni Sınıf Ekle" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>

                                <TextBlock Text="Sınıf Adı (Örn: 9-A):" Margin="0,0,0,4" Foreground="#34495E" FontSize="11"/>
                                <TextBox x:Name="txtSinifAd" Margin="0,0,0,10"/>
                                <TextBlock Text="Geleceği Gün Sayısı (0 = Serbest):" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtSinifHedefGunSayisi" Text="0" Margin="0,0,0,8"/>

                                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="Ders Yükü Ekle:" FontWeight="Bold" Margin="0,0,0,5" FontSize="11"/>
                                        <ComboBox x:Name="cmbSinifDersSecim" DisplayMemberPath="Ad" Margin="0,0,0,5" SelectionChanged="cmbSinifDersSecim_SelectionChanged"/>
                                        <ComboBox x:Name="cmbSinifOgretmenSecim" DisplayMemberPath="Ad" Margin="0,0,0,5"/>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtSinifDersSaat" Text="2"/>
                                            <Button Grid.Column="1" Content="➕ Yük Ekle" Background="#34495E" Margin="5,0,0,0" Padding="6,2" Click="btnSinifDersYukEkle_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ListBox x:Name="lstSinifDersYukleri" Height="95" Margin="0,0,0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DersAdi}" FontWeight="Bold"/>
                                                <TextBlock Text=" - "/>
                                                <TextBlock Text="{Binding SaatSayisi}"/>
                                                <TextBlock Text=" Saat "/>
                                                <TextBlock Text="{Binding ZorunluOgretmen.Ad, StringFormat='({0})', TargetNullValue='(Otomatik Seçim)'}" 
                           Foreground="DarkSlateGray" 
                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="➖ Yükü Sil" Background="#E74C3C" Margin="0,0,0,12" Click="btnSinifDersYukSil_Click"/>

                                <Button x:Name="btnSinifEkle" Content="➕ Sınıf Ekle" Background="#27AE60" Click="btnSinifEkle_Click"/>

                                <StackPanel x:Name="pnlSinifDuzenleButonlari" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Button Content="💾 Güncelle" Background="#2980B9" Margin="0,0,5,0" Click="btnSinifGuncelle_Click"/>
                                    <Button Content="❌ İptal" Background="#7F8C8D" Click="btnSinifDuzenleIptal_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="txtSinifAra" Margin="0,0,0,10" TextChanged="txtSinifAra_TextChanged"/>
                        <DataGrid Grid.Row="1" x:Name="dgSiniflar" AutoGenerateColumns="False" IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sınıf Adı" Binding="{Binding Ad}" Width="*"/>
                                <DataGridTextColumn Header="Toplam Ders Saati" Binding="{Binding ToplamDersSaati}" Width="140"/>
                                <DataGridTemplateColumn Header="İşlemler" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0">
                                                <Button Content="📅 Müsaitlik" Background="#3498DB" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnSinifMusaitlik_Click"/>
                                                <Button Content="✏️ Düzenle" Background="#F39C12" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnSinifDuzenle_Click"/>
                                                <Button Content="🗑️ Sil" Background="#E74C3C" Padding="8,3" Margin="2,0" VerticalAlignment="Center" Click="btnSinifSil_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
          

            <!-- ⚡ 4. SEKME: PROGRAM HAZIRLA & MOTOR -->
            <TabItem Header="⚡ Program Hazırla" FontSize="13" FontWeight="Bold" Padding="10,5">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Saatler (Virgülle):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0" FontSize="11"/>
                            <TextBox x:Name="txtSerbestSaatler" Text="08:30, 09:15, 10:00, 10:45, 11:30, 13:00, 13:45, 14:30" Width="200" Margin="0,0,10,0"/>

                            <TextBlock Text="Max Blok:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0" FontSize="11"/>
                            <TextBox x:Name="txtMaxBlok" Text="2" Width="30" HorizontalContentAlignment="Center" Margin="0,0,10,0"/>

                            <TextBlock Text="Min Blok:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0" FontSize="11"/>
                            <TextBox x:Name="txtMinBlok" Text="2" Width="30" HorizontalContentAlignment="Center" Margin="0,0,10,0"/>

                            <Button x:Name="btnProgramOlustur" Content="⚡ OLUŞTUR" Background="#27AE60" Click="btnProgramOlustur_Click" Margin="0,0,12,0"/>

                            <ComboBox x:Name="cmbGorunumTuru" Width="95" Margin="0,0,6,0" SelectionChanged="cmbGorunumTuru_SelectionChanged">
                                <ComboBoxItem Content="🏫 Sınıf" IsSelected="True"/>
                                <ComboBoxItem Content="👨‍🏫 Öğretmen"/>
                            </ComboBox>

                            <TextBlock x:Name="lblSecimEtiket" Text="Seç:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0" FontSize="11"/>
                            <ComboBox x:Name="cmbProgramSecim" Width="100" Margin="0,0,12,0" SelectionChanged="cmbProgramSecim_SelectionChanged"/>

                            <ComboBox x:Name="cmbPdfTur" Width="150" Margin="0,0,6,0">
                                <ComboBoxItem Content="📋 Sadece Sınıflar" IsSelected="True"/>
                                <ComboBoxItem Content="👨‍🏫 Sadece Öğretmenler"/>
                                <ComboBoxItem Content="📊 Genel Çarşaf Program"/>
                                <ComboBoxItem Content="📚 Tüm Programlar (Tümü)"/>
                            </ComboBox>

                            <Button x:Name="btnPdfOnizleme" Content="👁️ Rapor Önizle" Background="#8E44AD" Click="btnPdfOnizleme_Click"/>
                        </WrapPanel>
                    </Border>

                    <TextBlock Grid.Row="1" x:Name="lblProgramBaslik" Text="Ders Programı Matrisi" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Grid Grid.Row="2">
                        <UniformGrid x:Name="gridProgramMatris" Columns="8" Rows="11"/>

                        <Border x:Name="pnlYukleniyor" Background="#E6FFFFFF" CornerRadius="8" Visibility="Collapsed" Margin="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ Algoritma En İdeal Programı Hesaplıyor..." FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <ProgressBar Width="280" Height="12" IsIndeterminate="True" Foreground="#3498DB"/>
                                <TextBlock Text="Lütfen bekleyin, olasılıklar taranıyor..." FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,15"/>
                                <Button x:Name="btnAramayiIptalEt" Content="🛑 ARAMAYI İPTAL ET / GEÇ" Background="#C0392B" Click="btnAramayiIptalEt_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ⚙️ 5. SEKME: KURUM VE RAPOR AYARLARI -->
            <TabItem Header="⚙️ Kurum Ayarları" FontSize="13" FontWeight="Bold" Padding="10,5">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🏫 Kurum ve Resmi Rapor Bilgileri" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="20" Background="#FAFAFA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="520" HorizontalAlignment="Left">

                                <!-- 💳 ÜYELİK VE LİSANS BİLGİLERİ KARTI -->
                                <Border BorderBrush="#27AE60" BorderThickness="1.5" CornerRadius="6" Padding="15" Margin="0,0,0,20" Background="#F0F9F4">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="💳 Lisans &amp; Üyelik Durumu" FontWeight="Bold" FontSize="14" Foreground="#1E8449" VerticalAlignment="Center"/>
                                            <Border x:Name="brdLisansDurum" Background="#27AE60" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                <TextBlock x:Name="lblLisansDurumu" Text="AKTİF" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DockPanel>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Kayıtlı E-Posta / Okul:" FontSize="10" Foreground="Gray"/>
                                                <TextBlock x:Name="lblLisansEposta" Text="Yükleniyor..." FontWeight="Bold" FontSize="12" Foreground="#2C3E50" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Kalan Üyelik Süresi:" FontSize="10" Foreground="Gray"/>
                                                <TextBlock x:Name="lblLisansKalanGun" Text="-- Gün" FontWeight="Bold" FontSize="12" Foreground="#D35400" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Margin="0,8,0,8"/>

                                        <TextBlock Text="Üyelik Bitiş Tarihi:" FontSize="10" Foreground="Gray"/>
                                        <TextBlock x:Name="lblLisansBitisTarihi" Text="00.00.0000" FontWeight="SemiBold" FontSize="11" Foreground="#34495E" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Kurum / Okul Adı:" FontWeight="Bold" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="txtKurumAdi" Text="SERHAT ANADOLU LİSESİ" FontSize="13" Margin="0,0,0,12"/>

                                <TextBlock Text="Okul Müdürü (Ad Soyad):" FontWeight="Bold" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="txtMudurAd" Text="Okul Müdürü" FontSize="13" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="İl:" FontWeight="Bold" Margin="0,0,0,4" FontSize="11"/>
                                        <TextBox x:Name="txtIl" Text="MARDİN"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="İlçe:" FontWeight="Bold" Margin="0,0,0,4" FontSize="11"/>
                                        <TextBox x:Name="txtIlce" Text="ARTUKLU"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Rapor Alt Konu / Öğretim Yılı Metni:" FontWeight="Bold" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="txtRaporKonu" Text="2026-2027 Eğitim Öğretim Yılı Haftalık Ders Programı" Margin="0,0,0,15"/>

                                <Separator Margin="0,0,0,15"/>

                                <TextBlock Text="Okul / Kurum Logosu (İsteğe Bağlı):" FontWeight="Bold" Margin="0,0,0,5" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="btnLogoSec" Content="📁 Logo Seç (.png / .jpg)" Background="#34495E" Click="btnLogoSec_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="btnLogoTemizle" Content="❌ Logoyu Kaldır" Background="#E74C3C" Click="btnLogoTemizle_Click"/>
                                </StackPanel>

                                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Width="90" Height="90" HorizontalAlignment="Left" Background="White">
                                    <Image x:Name="imgLogoOnizleme" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Name="lblLogoDurum" Text="Henüz logo seçilmedi." FontSize="11" Foreground="Gray" Margin="0,4,0,15"/>

                                <Separator Margin="0,0,0,15"/>

                                <!-- 📦 BULUT YEDEKLEME KARTI -->
                                <Border BorderBrush="#3498DB" BorderThickness="1" CornerRadius="6" Padding="15" Background="#EBF5FB" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="📦 Sistem Yedekleme Yönetimi" FontWeight="Bold" FontSize="14" Foreground="#2980B9" Margin="0,0,0,8"/>
                                        <TextBlock Text="Yedekleriniz hem bu bilgisayara hem de bulut hesabınıza kaydedilir." FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

                                        <!-- 1. YEDEK ALMA -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtYedekAdi" materialDesign:HintAssist.Hint="Yedek İçin İsim (Örn: 2026 1. Dönem)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                                            <Button x:Name="btnYedekAl" Grid.Column="1" Content="➕ YEDEK AL" Height="38" Background="#27AE60" Click="btnYedekAl_Click"/>
                                        </Grid>

                                        <!-- 2. LİSTE -->
                                        <DataGrid x:Name="dgYedekler" Height="140" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Yedek Başlığı" Binding="{Binding BackupName}" Width="*"/>
                                                <DataGridTextColumn Header="Oluşturulma Tarihi" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- 3. GERİ YÜKLEME VE SİLME BUTONLARI -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button x:Name="btnYenile" Content="🔄 Yenile" Background="#7F8C8D" Margin="0,0,8,0" Click="btnYenile_Click"/>
                                            <Button x:Name="btnYedekSil" Content="🗑️ Yedeği Sil" Background="#E74C3C" Margin="0,0,8,0" Click="btnYedekSil_Click"/>
                                            <Button x:Name="btnGeriYukle" Content="📥 SEÇİLİ YEDEĞİ YÜKLE" Background="#2980B9" Click="btnGeriYukle_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 🚪 ÇIKIŞ YAP KARTI -->
                                <Border BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="15" Background="#FDEDEC">
                                    <StackPanel>
                                        <TextBlock Text="🚪 Oturum &amp; Çıkış İşlemleri" FontWeight="Bold" FontSize="14" Foreground="#C0392B" Margin="0,0,0,6"/>
                                        <TextBlock Text="Kayıtlı oturumunuzu kapatıp giriş ekranına dönmek için tıklayın." FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>
                                        <Button x:Name="btnCikisYap" Content="🚪 OTURUMU KAPAT / ÇIKIŞ YAP" Background="#C0392B" Foreground="White" Height="36" HorizontalAlignment="Left" Padding="15,0" Click="btnCikisYap_Click"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>