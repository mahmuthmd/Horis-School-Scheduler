<Window x:Class="DersProgramiUI.OnSartPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İnce Ayarlar / Ders Sabitleme (Ön Şartlar)" Height="600" Width="1100"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ÜST SEÇİM ALANI -->
        <Border Grid.Row="0" Background="#F4F6F7" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Sınıf Seç:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbSiniflar" Width="120" DisplayMemberPath="Ad" SelectionChanged="cmbSiniflar_SelectionChanged" Margin="0,0,20,0"/>

                <TextBlock Text="Sabitlenecek Ders:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbDersler" Width="150" DisplayMemberPath="Ad" SelectionChanged="cmbDersler_SelectionChanged" Margin="0,0,20,0"/>

                <TextBlock Text="Öğretmen:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbOgretmenler" Width="150" DisplayMemberPath="Ad" Margin="0,0,20,0"/>

                <TextBlock Text="💡 Kutulara tıklayarak dersi o güne/saate kilitleyebilirsiniz." Foreground="Gray" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- MATRİS ALANI -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10">
            <UniformGrid x:Name="gridMatris" Columns="12" Rows="8"/>
        </Border>

        <!-- BUTONLAR -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="💾 Ön Şartları Kaydet" Background="SeaGreen" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,10,0" Click="btnKaydet_Click"/>
            <Button Content="❌ Kapat" Background="Gray" Foreground="White" Padding="12,6" Click="btnKapat_Click"/>
        </StackPanel>
    </Grid>
</Window>